NODE_ENV=development
PORT=5000

# MongoDB
MONGO_URI=mongodb://127.0.0.1:27017/nagarsewa

# Auth
JWT_SECRET=change-this-to-a-long-random-string
JWT_EXPIRES_IN=7d

# Uploads
MAX_UPLOAD_MB=5

# ImageKit - required; report images are uploaded here.
# Keys: https://imagekit.io/dashboard/developer/api-keys
IMAGEKIT_PRIVATE_KEY=private_xxxxxxxxxxxxxxxxxxxxxxxxxxx
IMAGEKIT_PUBLIC_KEY=public_xxxxxxxxxxxxxxxxxxxxxxxxxxx
IMAGEKIT_URL_ENDPOINT=https://ik.imagekit.io/za6hatcci/nagarSewa/
IMAGEKIT_FOLDER=/nagar-sewa/reports

# Public base url used to build absolute image urls
PUBLIC_BASE_URL=http://localhost:5000

# CORS (comma separated, or * for all)
CORS_ORIGIN=*
