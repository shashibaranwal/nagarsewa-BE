PORT=3000
NODE_ENV=development
MONGODB_URI=
JWT_TOKEN=
JWT_EXPIRES_IN=7d
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
REPORT_MAX_IMAGES=5
REPORT_MAX_IMAGE_SIZE_MB=5
REPORT_DEFAULT_PAGE_SIZE=10
REPORT_MAX_PAGE_SIZE=50
ENABLE_NGROK=false
NGROK_DOMAIN=
# Phase 5 - issue matching (provisional thresholds, tune against real data)
ISSUE_MATCH_RADIUS_METERS=100
ISSUE_AUTO_MATCH_THRESHOLD=0.80
ISSUE_REVIEW_THRESHOLD=0.45
ISSUE_MATCH_TEXT_WEIGHT=0.7
ISSUE_MATCH_AMBIGUITY_MARGIN=0.05
ISSUE_MATCH_MAX_CANDIDATES=10
ISSUE_NEARBY_MAX_RADIUS_METERS=5000

# Phase 8 - automation (disabled unless true; priority/deadline/SLA rules live in src/config/automation.js)
ENABLE_AUTOMATION=false
AUTOMATION_INTERVAL_MINUTES=15
AUTOMATION_ESCALATION_GRACE_HOURS=48

# Geo-first matching + Gemini same-problem check (key is sent in the x-goog-api-key header, never logged)
GEMINI_API_KEY=
# GEMINI_MODELS=gemini-3.5-flash,gemini-flash-latest,gemini-3.8-flash
# GEO_SAME_SPOT_M=30
# GEO_CANDIDATE_M=100
# MATCHING_MODE=legacy   # uncomment to fall back to the old text-similarity/review-queue matching
# SCORE_JOB_ENABLED=true
